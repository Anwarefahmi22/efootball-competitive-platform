# PostgreSQL (async driver)
# Local dev:
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/efootball
# Hosted (e.g. Neon) — the sslmode parameter is handled automatically:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/efootball?sslmode=require

# JWT — replace JWT_SECRET_KEY in production
JWT_SECRET_KEY=your-secret-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
